# ============================================================================
# ENVIRONMENT VARIABLES - Sri Varahi Amma Real Estate
# ============================================================================
# 
# IMPORTANT SECURITY NOTES:
# - NEVER commit .env or .env.local to git (already in .gitignore)
# - This file (.env.example) is safe to commit as a template
# - Use .env.local for local development
# - Use Vercel Secrets for production deployments
#
# ============================================================================

# GEMINI_API_KEY
# Description: Google AI API key for AI-powered features
# Required: YES
# How to get:
#   1. Go to https://aistudio.google.com/app/apikeys
#   2. Create a new API key
#   3. Copy the key (format: AIzaSy...)
#   4. Paste into .env.local
# Security: Keep this secret! Never share or commit to git.
#
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY_HERE

# APP_URL
# Description: Full URL where this application is hosted
# Required: YES
# Examples:
#   - Local development: http://localhost:3000
#   - Vercel production: https://sri-varahi-amma-real-estate.vercel.app
#   - Custom domain: https://yourdomain.com
# Used for:
#   - Self-referential links
#   - OAuth callbacks
#   - API webhook URLs
#
APP_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: Advanced Configuration
# ============================================================================

# NODE_ENV
# Description: Runtime environment (development/production)
# Default: development
# Note: Vercel auto-detects this
#
# NODE_ENV=development

# PORT
# Description: Server port
# Default: 3000
# Note: Vercel overrides this automatically
#
# PORT=3000

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
#
# 1. COPY THIS FILE:
#    cp .env.example .env.local
#
# 2. EDIT .env.local:
#    - Add your GEMINI_API_KEY
#    - Set APP_URL to http://localhost:3000
#
# 3. FOR DEVELOPMENT:
#    npm install
#    npm run dev
#
# 4. FOR PRODUCTION (Vercel):
#    a) Push to GitHub
#    b) Connect to Vercel
#    c) Add env vars in Vercel → Project Settings → Environment Variables:
#       - GEMINI_API_KEY (marked as secret)
#       - APP_URL (your vercel deployment URL)
#    d) Redeploy
#
# ============================================================================
