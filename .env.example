# ============================================================================
# ENVIRONMENT VARIABLES — Sri Varahi Amma Real Estate
# ============================================================================
#
# HOW THIS FILE IS LOADED
#   server.ts calls dotenv with  { path: [".env.local", ".env"] }
#   → copy this file to .env.local and edit it. Never commit .env.local
#     (it is listed in .gitignore).
#
#   NOTE: before this fix nothing loaded .env.local at all, so the previous
#   "set it in .env.local" instructions had no effect.
#
#   On Vercel / any host: set these in the project's Environment Variables UI.
#
# ============================================================================

# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------
# Public base URL of the deployment (used for canonical links / sitemap).
APP_URL=http://localhost:3000
# NODE_ENV=production
# PORT=3000
# Directory for runtime data (enquiry log). Defaults to ./data
# DATA_DIR=./data
# Set to "false" only when the app is NOT behind a reverse proxy/CDN.
# TRUST_PROXY=true

# ----------------------------------------------------------------------------
# ADMIN — protects branding uploads and the enquiry inbox
# ----------------------------------------------------------------------------
# Required for: POST /api/deity-image (logo/artwork) and GET /api/inquiries.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value is pasted into the site's "Edit Contact Info → Global sync
# admin token" field by the owner. Without it, anonymous visitors can no longer
# overwrite the site artwork (that used to be possible).
ADMIN_API_TOKEN=

# ----------------------------------------------------------------------------
# OWNER / BROKER DESK LOGIN
# ----------------------------------------------------------------------------
# Preferred: sha256 hash of the PIN —  printf %s 4821 | sha256sum
BROKER_PIN_HASH=
# Simpler alternative for local use only (plain PIN, 4–8 digits)
BROKER_PIN=
# Display name shown after a successful owner login
BROKER_NAME=Harshith (Owner & Lead Realtor)

# ----------------------------------------------------------------------------
# SESSION SIGNING
# ----------------------------------------------------------------------------
# Signs buyer/owner session tokens. If unset, a random key is generated at boot
# and every restart invalidates existing sessions.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ----------------------------------------------------------------------------
# LEAD ALERTS — "ping my phone the moment someone enquires"
# ----------------------------------------------------------------------------
# Every enquiry is ALWAYS appended to data/inquiries.jsonl (the Owner Desk
# inbox). Each channel below is optional; configure any combination — they all
# fire in parallel and the startup banner lists the ones that are live.
#
# 1) TELEGRAM — free, instant push. Easiest to set up.
#    a. In Telegram, message @BotFather → /newbot → copy the token
#    b. Send your new bot any message
#    c. Open https://api.telegram.org/bot<TOKEN>/getUpdates → copy "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2) WHATSAPP Cloud API (official Meta). Needs a WhatsApp Business number.
#    LEAD_WHATSAPP_TO = your own number in international format (e.g. 919443123456)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
LEAD_WHATSAPP_TO=

# 3) EMAIL via Resend (simple API, free tier available)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=enquiries@srivarahiammarealestate.com

# 4) GENERIC WEBHOOK — Zapier / Make / n8n / Google Apps Script / Slack / CRM.
#    Receives the full lead JSON.
LEAD_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# SMS OTP PROVIDER — MSG91 (recommended: the dedicated OTP product)
# ----------------------------------------------------------------------------
# The OTP is generated and verified server-side already; without keys it is
# printed in the server log and (dev only) returned as `devCode`.
#
# To send real SMS in India you MUST complete DLT registration first — company
# entity (3-7 days), sender header (3-10 days per operator) and the OTP message
# template. Until those are approved, SMS will silently fail — the login flow
# keeps working through the dev code.
#
# In the MSG91 dashboard pick the "OTP" / "SendOTP" product, then copy:
#   Auth Key, Sender ID (6 chars) and the approved OTP Template ID.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# ----------------------------------------------------------------------------
# AI FEATURES (optional)
# ----------------------------------------------------------------------------
# @google/genai is installed but no feature currently calls it. Add the key only
# when you build the AI property-description or search-assistant feature.
GEMINI_API_KEY=

# ----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# ----------------------------------------------------------------------------
# Set to "true" to disable Vite HMR (useful inside sandboxes/editors).
# DISABLE_HMR=false
# Override the HMR websocket target when the dev server is proxied:
# HMR_CLIENT_PORT=443
# HMR_PROTOCOL=wss
